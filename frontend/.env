# Backend API URL
# During LOCAL development, leave this EMPTY — Vite's dev proxy handles routing
# to the backend automatically (see vite.config.ts proxy config).
# For production, set this to your deployed backend URL (origin only):
# VITE_API_URL=https://api.codecollab.noharafamily.xyz
# If /api is included, it is also supported.
VITE_API_URL=

# Collab Socket Server URL
# During LOCAL development, leave this EMPTY — Vite's dev proxy handles it.
# For production, set this to your deployed socket server URL:
# VITE_COLLAB_URL=https://collab.codecollab.noharafamily.xyz
VITE_COLLAB_URL=

# Gemini API Keys (comma-separated for rotation)
# Multiple keys will be rotated automatically to prevent exhaustion
VITE_GEMINI_API_KEYS=AIzaSyCDTqASS6n1HjtlYwjvMTDGWrd2WggyNN4,AIzaSyBTNGhZSknGm-8Ha3bhjRvIFg-JweE3JnU,AIzaSyBGqYz9Ex_AFvNZu2vUiIytXw_3pCWYfdg,AIzaSyD4pYr1QZUsOTeansS5nWEF0bP6F-WvoG8
